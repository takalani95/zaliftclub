# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=zalift_user
DB_PASSWORD=zalift_dev_password
DB_DATABASE=zaliftclub

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=zalift_redis_pass

# JWT
JWT_SECRET=zalift_jwt_secret_dev_change_in_prod
JWT_REFRESH_SECRET=zalift_refresh_secret_dev_change_in_prod
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3001
NODE_ENV=development

# Twilio (SMS) - add your keys later
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email) - add your key later
SENDGRID_API_KEY=

# Google Maps - add your key later
GOOGLE_MAPS_API_KEY=

# AWS S3 - add your keys later
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=zalift-assets
AWS_REGION=af-south-1
